# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development

# MySQL connection (create the database first: CREATE DATABASE elderguard_db;)
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/elderguard_db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated origins, or * during development
CORS_ORIGINS=*

# URL encoded into the hospital QR code. Use your PC's LAN IP so phones/clinic PCs can open it,
# e.g. http://192.168.1.20:8000
PUBLIC_BASE_URL=http://localhost:8000
TIMEZONE=Asia/Colombo

QR_TOKEN_TTL_HOURS=24
VITAL_STALE_AFTER_MINUTES=15
FALL_CONFIRM_SECONDS=25
MEDICATION_MISSED_GRACE_MINUTES=120

# Path to a Firebase service-account JSON to enable real push notifications (blank = simulated)
FCM_CREDENTIALS_FILE=
